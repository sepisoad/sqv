[executable]
path=.build/dapp
arguments=
ask_directory=1

[ui]
scale=1
font_path=/usr/local/share/fonts/SourceCodePro-Regular.ttf
font_size_interface=10
font_size_code=10
restore_watch_window=1
layout=h(75,v(75,Source,Console),v(50,t(Exe,Locals,Watch,Struct,Commands,CmdSearch,Log),t(Files,Stack,Registers,Data,Thread,Breakpoints))))

[commands]
